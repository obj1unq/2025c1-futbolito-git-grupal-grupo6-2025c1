import objetos.*
import pgmProgram.*


describe "test de camiseta" {

    test "cambiar camiseta de titular, a suplente, en lugar correcto" {
        lionel.position(game.at(0, 1))
        lionel.cambiarCamiseta()
        assert.equals(lionel.camiseta(),camisetaSuplente)
    }

    test "cambiar camiseta en lugar erroneo" {
        lionel.position(game.at(2, 4))
        assert.throwsException({lionel.cambiarCamiseta()})
    }

}
